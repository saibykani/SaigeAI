# ---- Saige AI configuration: placeholders only. Copy to .env and fill in. Never commit .env ----
ENVIRONMENT=development

# MongoDB Atlas connection string
MONGODB_URI=<MONGODB_CONNECTION_STRING>
MONGODB_DB=saige_ai

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<RANDOM_64_CHAR_SECRET>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set to true in any HTTPS deployment
COOKIE_SECURE=false

# Google OAuth (sign-in). Redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: key for encrypting stored OAuth tokens (32 bytes, urlsafe base64). If unset, one is
# derived from JWT_SECRET.
TOKEN_ENCRYPTION_KEY=
# Optional and off by default: Adzuna job-search API. Jobs for you works without it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Optional: Jooble job API (free key at https://jooble.org/api/about) - more listings for any role
JOOBLE_API_KEY=
# Optional: Telegram alerts - create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional WhatsApp Business Cloud API (Meta): two-way chat with Saige. Webhook: <backend>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Protects /api/cron/daily. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Super admin: this account always has admin rights (/admin) and can promote/demote admins.
SUPER_ADMIN_EMAIL=

# Optional: Claude enrichment for job-description analysis. Everything works without it;
# LLM output is verified against the JD text before use. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Reserved for a future OpenAI provider (not used yet)
OPENAI_API_KEY=

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Used by the Next.js server to proxy /api/* to FastAPI
BACKEND_URL=http://localhost:8000

MAX_UPLOAD_MB=5

# Optional: LinkedIn app ("Share on LinkedIn") for the daily posting agent.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
