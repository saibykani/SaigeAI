# ---- Saige AI configuration: placeholders only. Copy to .env and fill in. Never commit .env ----
ENVIRONMENT=development

# MongoDB Atlas connection string
MONGODB_URI=<MONGODB_CONNECTION_STRING>
MONGODB_DB=saige_ai

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<RANDOM_64_CHAR_SECRET>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set to true in any HTTPS deployment
COOKIE_SECURE=false

# Google OAuth (sign-in). Redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# LLM provider (used from Phase 2 onward)
OPENAI_API_KEY=

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Used by the Next.js server to proxy /api/* to FastAPI
BACKEND_URL=http://localhost:8000

MAX_UPLOAD_MB=5
