{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 2 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
