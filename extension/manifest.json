{
  "manifest_version": 3,
  "name": "Saige AI: job match & capture",
  "short_name": "Saige AI",
  "version": "1.1.0",
  "description": "Score and save jobs, fill application forms with your verified details and resume, and apply prepared LinkedIn / Naukri profile edits.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Saige AI",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://saige-ai-api.vercel.app/*", "http://localhost:8000/*"],
  "options_page": "options.html"
}
